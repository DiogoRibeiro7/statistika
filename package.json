{
  "name": "@diogoribeiro7/node_stats",
  "version": "2.0.0",
  "description": "Comprehensive statistical library for Node.js — distributions, hypothesis tests, regression models, correlation, and special math functions with optional native Fortran acceleration",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    },
    "./distributions": {
      "import": "./dist/esm/distributions/index.js",
      "require": "./dist/cjs/distributions/index.js",
      "types": "./dist/cjs/distributions/index.d.ts"
    },
    "./models": {
      "import": "./dist/esm/models/index.js",
      "require": "./dist/cjs/models/index.js",
      "types": "./dist/cjs/models/index.d.ts"
    },
    "./tests": {
      "import": "./dist/esm/tests/index.js",
      "require": "./dist/cjs/tests/index.js",
      "types": "./dist/cjs/tests/index.d.ts"
    },
    "./utils": {
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js",
      "types": "./dist/cjs/utils/index.d.ts"
    },
    "./bayesian": {
      "import": "./dist/esm/bayesian.js",
      "require": "./dist/cjs/bayesian.js",
      "types": "./dist/cjs/bayesian.d.ts"
    },
    "./mcmc": {
      "import": "./dist/esm/mcmc.js",
      "require": "./dist/cjs/mcmc.js",
      "types": "./dist/cjs/mcmc.d.ts"
    },
    "./time-series": {
      "import": "./dist/esm/time-series.js",
      "require": "./dist/cjs/time-series.js",
      "types": "./dist/cjs/time-series.d.ts"
    },
    "./garch": {
      "import": "./dist/esm/garch.js",
      "require": "./dist/cjs/garch.js",
      "types": "./dist/cjs/garch.d.ts"
    },
    "./var": {
      "import": "./dist/esm/var.js",
      "require": "./dist/cjs/var.js",
      "types": "./dist/cjs/var.d.ts"
    },
    "./glm": {
      "import": "./dist/esm/glm.js",
      "require": "./dist/cjs/glm.js",
      "types": "./dist/cjs/glm.d.ts"
    },
    "./gam": {
      "import": "./dist/esm/gam.js",
      "require": "./dist/cjs/gam.js",
      "types": "./dist/cjs/gam.d.ts"
    },
    "./survival": {
      "import": "./dist/esm/survival.js",
      "require": "./dist/cjs/survival.js",
      "types": "./dist/cjs/survival.d.ts"
    },
    "./state-space": {
      "import": "./dist/esm/state-space.js",
      "require": "./dist/cjs/state-space.js",
      "types": "./dist/cjs/state-space.d.ts"
    },
    "./changepoint": {
      "import": "./dist/esm/changepoint.js",
      "require": "./dist/cjs/changepoint.js",
      "types": "./dist/cjs/changepoint.d.ts"
    },
    "./causal-inference": {
      "import": "./dist/esm/causal-inference.js",
      "require": "./dist/cjs/causal-inference.js",
      "types": "./dist/cjs/causal-inference.d.ts"
    },
    "./dimensionality": {
      "import": "./dist/esm/dimensionality.js",
      "require": "./dist/cjs/dimensionality.js",
      "types": "./dist/cjs/dimensionality.d.ts"
    },
    "./spatial": {
      "import": "./dist/esm/spatial.js",
      "require": "./dist/cjs/spatial.js",
      "types": "./dist/cjs/spatial.d.ts"
    },
    "./meta-analysis": {
      "import": "./dist/esm/meta-analysis.js",
      "require": "./dist/cjs/meta-analysis.js",
      "types": "./dist/cjs/meta-analysis.d.ts"
    },
    "./resampling": {
      "import": "./dist/esm/resampling.js",
      "require": "./dist/cjs/resampling.js",
      "types": "./dist/cjs/resampling.d.ts"
    },
    "./diagnostics": {
      "import": "./dist/esm/diagnostics.js",
      "require": "./dist/cjs/diagnostics.js",
      "types": "./dist/cjs/diagnostics.d.ts"
    }
  },
  "files": [
    "dist",
    "native",
    "binding.gyp"
  ],
  "scripts": {
    "build": "yarn build:native && yarn build:ts",
    "build:native": "node scripts/build-native.js",
    "build:ts": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\" && node scripts/fix-esm-imports.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "bench": "npx ts-node benchmark/special-functions.ts",
    "bench:linalg": "npx ts-node benchmark/linalg.ts",
    "bench:all": "npx ts-node benchmark/special-functions.ts && npx ts-node benchmark/linalg.ts",
    "docs": "typedoc",
    "install": "node scripts/build-native.js",
    "prepublishOnly": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DiogoRibeiro7/node_stats.git"
  },
  "homepage": "https://github.com/DiogoRibeiro7/node_stats#readme",
  "bugs": {
    "url": "https://github.com/DiogoRibeiro7/node_stats/issues"
  },
  "keywords": [
    "statistics",
    "regression",
    "hypothesis-testing",
    "probability",
    "distributions",
    "correlation",
    "t-test",
    "anova",
    "chi-squared",
    "linear-regression",
    "logistic-regression",
    "math",
    "data-science",
    "bayesian",
    "mcmc",
    "time-series",
    "arima",
    "garch",
    "kalman-filter",
    "survival-analysis",
    "glm",
    "gam",
    "pca",
    "clustering",
    "causal-inference",
    "meta-analysis",
    "machine-learning"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "author": "Diogo Ribeiro",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "optionalDependencies": {
    "node-addon-api": "^8.6.0",
    "node-gyp": "^12.2.0"
  }
}
